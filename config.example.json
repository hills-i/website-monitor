{
    "OpenAI_API_Key": "YOUR_API_KEY_HERE",
    "OpenAI_ApiEndpoint": "https://api.openai.com/v1/chat/completions",
    "OpenAI_Model": "gpt-5-nano",
    "OpenAI_ReasoningEffort": "low",
    "OpenAI_Temperature": 0.5,
    "Request_TimeoutSeconds": 30,
    "Request_MaxRetries": 1,
    "Request_RetryBackoffSeconds": 1,
    "Max_Diff_Lines": 500,
    "Redaction_Patterns": [
        "password\\s*[:=]\\s*[\"'][^\"'>]*[\"']",
        "api[_-]?key\\s*[:=]\\s*[\"'][^\"'>]*[\"']",
        "token\\s*[:=]\\s*[\"'][^\"'>]*[\"']"
    ],
    "Sites_File": "website.txt",
    "Output_Directory": "output",
    "Crawl_DelaySeconds": 3,
    "HTML_Filtering_Enabled": true,
    "HTML_Filtering_Method": "trafilatura",
    "HTML_Filtering_Fallback": "beautifulsoup",
    "Trafilatura_Options": {
        "include_links": true,
        "include_images": false,
        "include_formatting": true,
        "deduplicate": true,
        "favor_precision": false
    },
    "BeautifulSoup_Remove_Elements": [
        "nav",
        "header",
        "footer",
        "aside",
        "script",
        "style",
        "noscript",
        "form",
        "input",
        "button",
        "select",
        "textarea",
        "iframe",
        "embed",
        "object",
        "img",
        "svg",
        "picture"
    ],
    "BeautifulSoup_Remove_Class_Patterns": [
        "sidebar",
        "menu",
        "navigation",
        "nav",
        "header",
        "footer",
        "breadcrumb",
        "advertisement",
        "ad-",
        "social",
        "share",
        "comment",
        "cookie",
        "popup"
    ],
    "Markdown_Cleanup_Enabled": true,
    "Markdown_Cleanup_Patterns": [
        "^:::.*$",
        "^{\\.[^}]*}$",
        "^</?div.*>$",
        "^</?span.*>$",
        "^</?figure.*>$",
        "^\\[\\]$"
    ]
}